# ---------------------------------------------------------------------------
# Shivoraa Studio — environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database ---
POSTGRES_USER=shivoraa
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=shivoraa
POSTGRES_PORT=5432

# --- Ports ---
API_PORT=8000
WEB_PORT=8080

# --- Security ---
# Generate: openssl rand -hex 32
SHIVORAA_SECRET_KEY=dev-only-change-me-in-production-please-32b

# Encrypts provider API keys and secret environment variables at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production. Rotating this makes existing secrets unreadable.
SHIVORAA_ENCRYPTION_KEY=

# --- Environment ---
# local | staging | production
SHIVORAA_ENVIRONMENT=local

# saas         — private networks are blocked (SSRF protection)
# self_hosted  — private networks are allowed, because reaching your own
#                internal services is the reason you self-host
SHIVORAA_DEPLOYMENT_MODE=saas

# --- CORS (comma-separated, exact origins, never a wildcard) ---
SHIVORAA_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Cookies ---
# Must be true in production (requires HTTPS).
SHIVORAA_COOKIE_SECURE=false

# --- AI trial (optional) ---
# An OpenAI key used only for the 50 free actions new users get before
# connecting their own provider. Leave blank to disable the trial.
SHIVORAA_TRIAL_OPENAI_KEY=

# ---------------------------------------------------------------------------
# Production example for shivoraa.in
# ---------------------------------------------------------------------------
# SHIVORAA_ENVIRONMENT=production
# SHIVORAA_COOKIE_SECURE=true
# SHIVORAA_CORS_ORIGINS=https://app.shivoraa.in
# SHIVORAA_DATABASE_URL=postgresql+asyncpg://user:pass@db-host:5432/shivoraa
